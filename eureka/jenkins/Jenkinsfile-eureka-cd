@Library('jenkins-shared-lib-deno@main') _

pipeline {
    agent any

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'qa', 'prod'], description: 'Target environment')
        string(name: 'AMI_ID', defaultValue: '', description: 'Eureka AMI ID')
        choice(name: 'ACTION', choices: ['apply', 'destroy', 'plan'], description: 'Terraform action')
    }

    environment {
        AWS_ACCESS_KEY_ID = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
    }

    stages {
        stage('Load Environment Configuration') {
            steps {
                script {
                    // Get environment-specific config
                    def envConfig = envConfig().getEnvConfig(params.ENVIRONMENT)
                    def globalConfig = envConfig()
                    
                    env.AWS_DEFAULT_REGION = globalConfig.aws.region
                    env.EUREKA_PORT = globalConfig.eureka.defaultPort
                    env.AMI_ID = params.AMI_ID
                    env.TARGET_ENV = params.ENVIRONMENT
                    
                    // Environment-specific variables
                    env.SUBNET_ID = envConfig.subnet_id
                    env.VPC_ID = envConfig.vpc_id
                    env.INSTANCE_TYPE = envConfig.instance_type
                    env.SSM_PATH = envConfig.ssm_path
                    env.VPC_CIDR = envConfig.vpc_cidr
                    
                    echo "=========================================="
                    echo "Eureka CD Pipeline - ${params.ENVIRONMENT.toUpperCase()}"
                    echo "=========================================="
                    echo "Environment: ${params.ENVIRONMENT}"
                    echo "Action: ${params.ACTION}"
                    echo "VPC CIDR: ${env.VPC_CIDR}"
                    echo "Instance Type: ${env.INSTANCE_TYPE}"
                    echo "Subnet ID: ${env.SUBNET_ID}"
                    echo "SSM Path: ${env.SSM_PATH}"
                    echo "AMI ID: ${env.AMI_ID ?: 'Will use latest'}"
                    echo "=========================================="
                }
            }
        }

        stage('Checkout') {
            steps {
                git url: 'https://github.com/kartikeyasoft/micro.git', branch: 'main'
            }
        }

        stage('Get AMI ID') {
            when { expression { params.ACTION in ['apply', 'plan'] } }
            steps {
                script {
                    def amiId = params.AMI_ID
                    
                    if (!amiId || amiId == '') {
                        // Get latest generic AMI (no environment tag in CI)
                        amiId = sh(script: """
                            aws ec2 describe-images \
                                --region ${env.AWS_DEFAULT_REGION} \
                                --owners self \
                                --filters "Name=name,Values=eureka-v*" \
                                --query 'Images | sort_by(@, &CreationDate) | [-1].ImageId' \
                                --output text
                        """, returnStdout: true).trim()
                        
                        if (!amiId || amiId == '') {
                            error "No Eureka AMI found! Run eureka-ci first."
                        }
                        echo "✅ Using latest AMI: ${amiId}"
                    } else {
                        echo "✅ Using provided AMI ID: ${amiId}"
                    }
                    
                    env.AMI_ID = amiId
                }
            }
        }

        stage('Validate') {
            when { expression { params.ACTION in ['apply', 'plan'] } }
            steps {
                script {
                    if (!env.AMI_ID || env.AMI_ID == '') {
                        error "AMI_ID is required for apply action"
                    }
                    echo "✅ Validation passed for ${params.ENVIRONMENT}"
                }
            }
        }

        stage('Terraform Init') {
            steps {
                dir("eureka/terraform/${params.ENVIRONMENT}") {
                    // Copy terraform files
                    sh """
                        cp ../*.tf . 2>/dev/null || true
                        terraform init
                    """
                }
            }
        }

        stage('Terraform Plan') {
            when { expression { params.ACTION == 'plan' } }
            steps {
                dir("eureka/terraform/${params.ENVIRONMENT}") {
                    sh """
                        terraform plan \
                            -var="ami_id=${env.AMI_ID}" \
                            -var="aws_region=${env.AWS_DEFAULT_REGION}" \
                            -var="eureka_port=${env.EUREKA_PORT}" \
                            -var="environment=${params.ENVIRONMENT}" \
                            -var="subnet_id=${env.SUBNET_ID}" \
                            -var="vpc_id=${env.VPC_ID}" \
                            -var="instance_type=${env.INSTANCE_TYPE}"
                    """
                }
            }
        }

        stage('Terraform Apply') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                dir("eureka/terraform/${params.ENVIRONMENT}") {
                    sh """
                        terraform apply -auto-approve \
                            -var="ami_id=${env.AMI_ID}" \
                            -var="aws_region=${env.AWS_DEFAULT_REGION}" \
                            -var="eureka_port=${env.EUREKA_PORT}" \
                            -var="environment=${params.ENVIRONMENT}" \
                            -var="subnet_id=${env.SUBNET_ID}" \
                            -var="vpc_id=${env.VPC_ID}" \
                            -var="instance_type=${env.INSTANCE_TYPE}"
                    """
                }
            }
        }

        stage('Store Service Discovery Info') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                script {
                    dir("eureka/terraform/${params.ENVIRONMENT}") {
                        def private_ip = ""
                        try {
                            private_ip = sh(script: "terraform output -raw eureka_private_ip", returnStdout: true).trim()
                        } catch (Exception e) {
                            private_ip = sh(script: """
                                aws ec2 describe-instances \
                                    --filters "Name=tag:Environment,Values=${params.ENVIRONMENT}" "Name=tag:Service,Values=eureka" \
                                    --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                                    --region ${env.AWS_DEFAULT_REGION} \
                                    --output text
                            """, returnStdout: true).trim()
                        }
                        
                        if (private_ip && private_ip != 'None') {
                            sh """
                                aws ssm put-parameter \
                                    --name "${env.SSM_PATH}/eureka/ip" \
                                    --value "${private_ip}" \
                                    --type "String" \
                                    --overwrite
                                
                                aws ssm put-parameter \
                                    --name "${env.SSM_PATH}/eureka/port" \
                                    --value "${env.EUREKA_PORT}" \
                                    --type "String" \
                                    --overwrite
                                
                                aws ssm put-parameter \
                                    --name "${env.SSM_PATH}/eureka/ami" \
                                    --value "${env.AMI_ID}" \
                                    --type "String" \
                                    --overwrite
                            """
                            
                            echo "=========================================="
                            echo "✅ ${params.ENVIRONMENT.toUpperCase()} Eureka Deployed"
                            echo "=========================================="
                            echo "IP: ${private_ip}"
                            echo "Port: ${env.EUREKA_PORT}"
                            echo "URL: http://${private_ip}:${env.EUREKA_PORT}/eureka/"
                            echo "SSM Path: ${env.SSM_PATH}/eureka/"
                            echo "=========================================="
                        }
                    }
                }
            }
        }

        stage('Terraform Destroy') {
            when { expression { params.ACTION == 'destroy' } }
            steps {
                script {
                    sh """
                        aws ssm delete-parameter --name "${env.SSM_PATH}/eureka/ip" 2>/dev/null || true
                        aws ssm delete-parameter --name "${env.SSM_PATH}/eureka/port" 2>/dev/null || true
                        aws ssm delete-parameter --name "${env.SSM_PATH}/eureka/ami" 2>/dev/null || true
                    """
                }
                dir("eureka/terraform/${params.ENVIRONMENT}") {
                    sh "terraform destroy -auto-approve"
                }
            }
        }

        stage('Output') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                script {
                    echo "=========================================="
                    echo "✅ ${params.ENVIRONMENT.toUpperCase()} Deployment Complete!"
                    echo "=========================================="
                    echo "Environment: ${params.ENVIRONMENT}"
                    echo "AMI ID: ${env.AMI_ID}"
                    echo "Instance Type: ${env.INSTANCE_TYPE}"
                    echo "=========================================="
                }
            }
        }
    }

    post {
        success {
            echo "✅ Eureka ${params.ACTION} for ${params.ENVIRONMENT} completed!"
        }
        failure {
            echo "❌ Eureka ${params.ACTION} for ${params.ENVIRONMENT} failed!"
        }
    }
}