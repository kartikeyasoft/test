@Library('jenkins-shared-lib-deno@main') _

pipeline {
    agent any

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'qa', 'prod'], description: 'Target environment')
        string(name: 'AMI_ID', defaultValue: '', description: 'Eureka AMI ID (leave empty to get latest from SSM)')
        choice(name: 'ACTION', choices: ['apply', 'destroy', 'plan'], description: 'Terraform action')
    }

    environment {
        AWS_ACCESS_KEY_ID = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
    }

    stages {
        stage('Load Environment Configuration') {
            steps {
                script {
                    // Get environment-specific config
                    def globalConfig = envConfig()
                    def envConfigData = globalConfig.getEnvConfig(params.ENVIRONMENT)
                    
                    env.AWS_DEFAULT_REGION = globalConfig.aws.region
                    env.EUREKA_PORT = globalConfig.eureka.defaultPort
                    env.SERVICE_NAME = globalConfig.servicename.obj1
                    env.S3_BUCKET = globalConfig.s3.bucket
                    env.AMI_ID = params.AMI_ID
                    env.TARGET_ENV = params.ENVIRONMENT
                    
                    // Environment-specific variables
                    env.SUBNET_ID = envConfigData.subnet_id
                    env.VPC_ID = envConfigData.vpc_id
                    env.INSTANCE_TYPE = envConfigData.instance_type
                    env.SSM_PATH = envConfigData.ssm_path
                    env.VPC_CIDR = envConfigData.vpc_cidr
                    
                    echo "=========================================="
                    echo "Eureka CD Pipeline - ${params.ENVIRONMENT.toUpperCase()}"
                    echo "=========================================="
                    echo "Service Name: ${env.SERVICE_NAME}"
                    echo "Environment: ${params.ENVIRONMENT}"
                    echo "Action: ${params.ACTION}"
                    echo "VPC CIDR: ${env.VPC_CIDR}"
                    echo "Instance Type: ${env.INSTANCE_TYPE}"
                    echo "Subnet ID: ${env.SUBNET_ID}"
                    echo "SSM Path: ${env.SSM_PATH}"
                    echo "AMI ID: ${env.AMI_ID ?: 'Will get latest from SSM'}"
                    echo "=========================================="
                }
            }
        }

        stage('Checkout') {
            steps {
                git url: 'https://github.com/kartikeyasoft/micro.git', branch: 'main'
            }
        }

        stage('Get AMI ID from SSM') {
            when { expression { params.ACTION in ['apply', 'plan'] && (!env.AMI_ID || env.AMI_ID == '') } }
            steps {
                script {
                    // Map environment to CI branch pattern
                    def branch = params.ENVIRONMENT == 'prod' ? 'master' : params.ENVIRONMENT
                    
                    echo "Getting latest AMI for branch: ${branch}"
                    
                    // Get AMI ID from SSM (as stored by CI pipeline)
                    def amiId = sh(script: """
                        aws ssm get-parameter \
                            --name "/eureka/${branch}/latest-ami" \
                            --region ${env.AWS_DEFAULT_REGION} \
                            --query "Parameter.Value" \
                            --output text 2>/dev/null || echo ""
                    """, returnStdout: true).trim()
                    
                    if (!amiId || amiId == '') {
                        error """
                        No Eureka AMI found in SSM for branch: ${branch}
                        
                        Please run eureka-ci pipeline for ${branch} branch first.
                        SSM Path expected: /eureka/${branch}/latest-ami
                        """
                    }
                    
                    env.AMI_ID = amiId
                    echo "✅ Using latest AMI from SSM: ${env.AMI_ID}"
                    
                    // Also get metadata location for reference
                    def metadataLocation = sh(script: """
                        aws ssm get-parameter \
                            --name "/eureka/${branch}/metadata-location" \
                            --region ${env.AWS_DEFAULT_REGION} \
                            --query "Parameter.Value" \
                            --output text 2>/dev/null || echo ""
                    """, returnStdout: true).trim()
                    
                    if (metadataLocation) {
                        echo "📝 AMI Metadata: ${metadataLocation}"
                    }
                }
            }
        }

        stage('Validate AMI ID') {
            when { expression { params.ACTION in ['apply', 'plan'] } }
            steps {
                script {
                    if (!env.AMI_ID || env.AMI_ID == '') {
                        error "AMI_ID is required for ${params.ACTION} action. Provide it as parameter or ensure CI pipeline has run."
                    }
                    
                    // Verify AMI exists
                    def amiExists = sh(script: """
                        aws ec2 describe-images \
                            --image-ids ${env.AMI_ID} \
                            --region ${env.AWS_DEFAULT_REGION} \
                            --query 'Images[0].ImageId' \
                            --output text 2>/dev/null || echo ""
                    """, returnStdout: true).trim()
                    
                    if (!amiExists || amiExists == '') {
                        error "AMI ${env.AMI_ID} does not exist in region ${env.AWS_DEFAULT_REGION}"
                    }
                    
                    echo "✅ Validation passed for ${params.ENVIRONMENT}"
                    echo "✅ AMI ${env.AMI_ID} is valid"
                }
            }
        }

        stage('Terraform Init') {
            steps {
                dir("eureka/terraform/${params.ENVIRONMENT}") {
                    sh """
                        cp ../*.tf . 2>/dev/null || true
                        terraform init
                    """
                }
            }
        }

        stage('Terraform Plan') {
            when { expression { params.ACTION == 'plan' } }
            steps {
                dir("eureka/terraform/${params.ENVIRONMENT}") {
                    sh """
                        terraform plan \
                            -var="ami_id=${env.AMI_ID}" \
                            -var="service_name=${env.SERVICE_NAME}" \
                            -var="aws_region=${env.AWS_DEFAULT_REGION}" \
                            -var="eureka_port=${env.EUREKA_PORT}" \
                            -var="environment=${params.ENVIRONMENT}" \
                            -var="subnet_id=${env.SUBNET_ID}" \
                            -var="vpc_id=${env.VPC_ID}" \
                            -var="instance_type=${env.INSTANCE_TYPE}"
                    """
                }
            }
        }

        stage('Terraform Apply') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                dir("eureka/terraform/${params.ENVIRONMENT}") {
                    sh """
                        terraform apply -auto-approve \
                            -var="ami_id=${env.AMI_ID}" \
                            -var="service_name=${env.SERVICE_NAME}" \
                            -var="aws_region=${env.AWS_DEFAULT_REGION}" \
                            -var="eureka_port=${env.EUREKA_PORT}" \
                            -var="environment=${params.ENVIRONMENT}" \
                            -var="subnet_id=${env.SUBNET_ID}" \
                            -var="vpc_id=${env.VPC_ID}" \
                            -var="instance_type=${env.INSTANCE_TYPE}"
                    """
                }
            }
        }

        stage('Store Service Discovery Info') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                script {
                    dir("eureka/terraform/${params.ENVIRONMENT}") {
                        def private_ip = ""
                        def public_ip = ""
                        
                        try {
                            private_ip = sh(script: "terraform output -raw eureka_private_ip", returnStdout: true).trim()
                            public_ip = sh(script: "terraform output -raw eureka_public_ip", returnStdout: true).trim()
                        } catch (Exception e) {
                            echo "Terraform output not available, querying AWS directly..."
                            private_ip = sh(script: """
                                aws ec2 describe-instances \
                                    --filters "Name=tag:Environment,Values=${params.ENVIRONMENT}" \
                                              "Name=tag:Service,Values=${env.SERVICE_NAME}" \
                                    --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                                    --region ${env.AWS_DEFAULT_REGION} \
                                    --output text
                            """, returnStdout: true).trim()
                            
                            public_ip = sh(script: """
                                aws ec2 describe-instances \
                                    --filters "Name=tag:Environment,Values=${params.ENVIRONMENT}" \
                                              "Name=tag:Service,Values=${env.SERVICE_NAME}" \
                                    --query 'Reservations[0].Instances[0].PublicIpAddress' \
                                    --region ${env.AWS_DEFAULT_REGION} \
                                    --output text
                            """, returnStdout: true).trim()
                        }
                        
                        if (private_ip && private_ip != 'None' && private_ip != '') {
                            // Store in SSM
                            sh """
                                aws ssm put-parameter \
                                    --name "${env.SSM_PATH}/${env.SERVICE_NAME}/ip" \
                                    --value "${private_ip}" \
                                    --type "String" \
                                    --overwrite || true
                                
                                aws ssm put-parameter \
                                    --name "${env.SSM_PATH}/${env.SERVICE_NAME}/public-ip" \
                                    --value "${public_ip}" \
                                    --type "String" \
                                    --overwrite || true
                                
                                aws ssm put-parameter \
                                    --name "${env.SSM_PATH}/${env.SERVICE_NAME}/port" \
                                    --value "${env.EUREKA_PORT}" \
                                    --type "String" \
                                    --overwrite || true
                                
                                aws ssm put-parameter \
                                    --name "${env.SSM_PATH}/${env.SERVICE_NAME}/ami" \
                                    --value "${env.AMI_ID}" \
                                    --type "String" \
                                    --overwrite || true
                                
                                aws ssm put-parameter \
                                    --name "${env.SSM_PATH}/${env.SERVICE_NAME}/deployed-at" \
                                    --value "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
                                    --type "String" \
                                    --overwrite || true
                            """
                            
                            echo "=========================================="
                            echo "✅ ${params.ENVIRONMENT.toUpperCase()} Eureka Deployed Successfully"
                            echo "=========================================="
                            echo "Service: ${env.SERVICE_NAME}"
                            echo "Private IP: ${private_ip}"
                            echo "Public IP: ${public_ip}"
                            echo "Port: ${env.EUREKA_PORT}"
                            echo "URL: http://${private_ip}:${env.EUREKA_PORT}/eureka/"
                            echo "AMI ID: ${env.AMI_ID}"
                            echo "SSM Path: ${env.SSM_PATH}/${env.SERVICE_NAME}/"
                            echo "=========================================="
                        } else {
                            error "Failed to get instance IP address for ${params.ENVIRONMENT}"
                        }
                    }
                }
            }
        }

        stage('Terraform Destroy') {
            when { expression { params.ACTION == 'destroy' } }
            steps {
                script {
                    // Clean up SSM parameters
                    sh """
                        aws ssm delete-parameter --name "${env.SSM_PATH}/${env.SERVICE_NAME}/ip" 2>/dev/null || true
                        aws ssm delete-parameter --name "${env.SSM_PATH}/${env.SERVICE_NAME}/public-ip" 2>/dev/null || true
                        aws ssm delete-parameter --name "${env.SSM_PATH}/${env.SERVICE_NAME}/port" 2>/dev/null || true
                        aws ssm delete-parameter --name "${env.SSM_PATH}/${env.SERVICE_NAME}/ami" 2>/dev/null || true
                        aws ssm delete-parameter --name "${env.SSM_PATH}/${env.SERVICE_NAME}/deployed-at" 2>/dev/null || true
                    """
                }
                dir("eureka/terraform/${params.ENVIRONMENT}") {
                    sh "terraform destroy -auto-approve"
                }
            }
        }

        stage('Output') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                script {
                    echo "=========================================="
                    echo "✅ ${params.ENVIRONMENT.toUpperCase()} Deployment Complete!"
                    echo "=========================================="
                    echo "Environment: ${params.ENVIRONMENT}"
                    echo "Service: ${env.SERVICE_NAME}"
                    echo "AMI ID: ${env.AMI_ID}"
                    echo "Instance Type: ${env.INSTANCE_TYPE}"
                    echo "=========================================="
                }
            }
        }
    }

    post {
        success {
            echo "=========================================="
            echo "✅ Eureka ${params.ACTION} for ${params.ENVIRONMENT} completed!"
            echo "=========================================="
        }
        failure {
            echo "=========================================="
            echo "❌ Eureka ${params.ACTION} for ${params.ENVIRONMENT} failed!"
            echo "=========================================="
            echo "Check logs above for details."
        }
    }
}