@Library('jenkins-shared-lib-deno@main') _

pipeline {
    agent any

    parameters {
        choice(name: 'ACTION', choices: ['apply', 'destroy', 'plan'], description: 'Terraform action')
        string(name: 'AMI_ID', defaultValue: '', description: 'Eureka AMI ID (leave empty to get latest from SSM based on branch)')
        choice(name: 'BRANCH', choices: ['dev', 'qa', 'master'], description: 'Git branch (maps to environment: dev→dev, qa→qa, master→prod)')
    }

    environment {
        AWS_ACCESS_KEY_ID = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
    }

    stages {
        stage('Load Environment Configuration') {
            steps {
                script {
                    // Get timestamp first
                    env.TIMESTAMP = sh(script: 'date +%Y%m%d-%H%M%S', returnStdout: true).trim()
                    
                    // Get configurations from shared library
                    def globalConfig = envConfig()
                    def branchConfig = globalConfig.getBranchConfig(params.BRANCH)
                    def envConfigData = globalConfig.getEnvConfig(branchConfig.environment)
                    
                    // Set environment variables
                    env.BUILD_BRANCH = params.BRANCH
                    env.TARGET_ENV = branchConfig.environment
                    env.DEPLOY_STRATEGY = branchConfig.deploy_strategy
                    env.AUTO_DEPLOY = branchConfig.auto_deploy.toString()
                    env.REQUIRE_APPROVAL = branchConfig.require_approval.toString()
                    
                    // AWS Configuration
                    env.AWS_DEFAULT_REGION = globalConfig.aws.region
                    env.SERVICE_NAME = globalConfig.servicename.obj1
                    env.S3_BUCKET = globalConfig.s3.bucket?.trim()
                    env.EUREKA_PORT = globalConfig.eureka.defaultPort
                    
                    // Environment-specific VPC configuration
                    env.VPC_CIDR = envConfigData.vpc_cidr
                    env.SUBNET_ID = envConfigData.subnet_id
                    env.VPC_ID = envConfigData.vpc_id
                    env.INSTANCE_TYPE = branchConfig.instance_type
                    env.SSM_PATH = branchConfig.ssm_path
                    
                    // AMI ID (use provided or fetch from SSM later)
                    env.AMI_ID = params.AMI_ID
                    
                    echo "=========================================="
                    echo "Eureka CD Pipeline - Branch: ${params.BRANCH}"
                    echo "=========================================="
                    echo "Timestamp: ${env.TIMESTAMP}"
                    echo "Target Environment: ${env.TARGET_ENV}"
                    echo "Action: ${params.ACTION}"
                    echo "Deploy Strategy: ${env.DEPLOY_STRATEGY}"
                    echo "Auto Deploy: ${env.AUTO_DEPLOY}"
                    echo "Require Approval: ${env.REQUIRE_APPROVAL}"
                    echo ""
                    echo "VPC Configuration:"
                    echo "  VPC CIDR: ${env.VPC_CIDR}"
                    echo "  VPC ID: ${env.VPC_ID}"
                    echo "  Subnet ID: ${env.SUBNET_ID}"
                    echo "  Instance Type: ${env.INSTANCE_TYPE}"
                    echo ""
                    echo "Service Configuration:"
                    echo "  Service Name: ${env.SERVICE_NAME}"
                    echo "  Eureka Port: ${env.EUREKA_PORT}"
                    echo "  SSM Path: ${env.SSM_PATH}"
                    echo "  S3 Bucket: ${env.S3_BUCKET}"
                    echo ""
                    echo "AMI ID: ${env.AMI_ID ?: 'Will fetch from SSM based on branch'}"
                    echo "=========================================="
                }
            }
        }

        stage('Checkout Infrastructure Code') {
            steps {
                script {
                    def infraRepo = 'https://github.com/kartikeyasoft/test.git'
                    def infraBranch = params.BRANCH
                    
                    echo "=========================================="
                    echo "Checking out infrastructure code"
                    echo "=========================================="
                    echo "Repository: ${infraRepo}"
                    echo "Branch: ${infraBranch}"
                    
                    // Clean previous checkout
                    deleteDir()
                    
                    checkout([$class: 'GitSCM',
                        branches: [[name: infraBranch]],
                        userRemoteConfigs: [[url: infraRepo]],
                        extensions: [[$class: 'CleanCheckout']]
                    ])
                    
                    env.INFRA_COMMIT = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.INFRA_BRANCH = infraBranch
                    
                    echo "✅ Checkout complete"
                    echo "   Commit: ${env.INFRA_COMMIT}"
                    echo "   Branch: ${env.INFRA_BRANCH}"
                    echo "=========================================="
                }
            }
        }

        stage('Approval Required') {
            when { 
                expression { 
                    params.ACTION == 'apply' && 
                    env.REQUIRE_APPROVAL == 'true' 
                } 
            }
            steps {
                input message: "Approve deployment to ${env.TARGET_ENV} (${env.BUILD_BRANCH} branch)?",
                    ok: "Deploy",
                    parameters: [
                        string(name: 'APPROVER', defaultValue: "${env.BUILD_USER_ID ?: 'Unknown'}", description: 'Approver name'),
                        text(name: 'DEPLOY_NOTES', defaultValue: "Deploying ${env.SERVICE_NAME} from ${env.BUILD_BRANCH} branch", description: 'Deployment notes')
                    ]
            }
        }

        stage('Get AMI ID from SSM') {
            when { 
                expression { 
                    params.ACTION in ['apply', 'plan'] && 
                    (!env.AMI_ID || env.AMI_ID == '') 
                } 
            }
            steps {
                script {
                    echo "Fetching latest AMI for branch: ${env.BUILD_BRANCH}"
                    
                    def amiId = sh(script: """
                        aws ssm get-parameter \
                            --name "/eureka/${env.BUILD_BRANCH}/latest-ami" \
                            --region ${env.AWS_DEFAULT_REGION} \
                            --query "Parameter.Value" \
                            --output text 2>/dev/null || echo ""
                    """, returnStdout: true).trim()
                    
                    if (!amiId || amiId == '') {
                        error """
                        ❌ No Eureka AMI found for branch: ${env.BUILD_BRANCH}
                        
                        Please run eureka-ci pipeline for ${env.BUILD_BRANCH} branch first.
                        Expected SSM path: /eureka/${env.BUILD_BRANCH}/latest-ami
                        """
                    }
                    
                    env.AMI_ID = amiId
                    echo "✅ Using AMI from SSM: ${env.AMI_ID}"
                }
            }
        }

        stage('Validate AMI') {
            when { expression { params.ACTION in ['apply', 'plan'] } }
            steps {
                script {
                    if (!env.AMI_ID || env.AMI_ID == '') {
                        error "AMI_ID is required for ${params.ACTION} action"
                    }
                    
                    // Verify AMI exists
                    def amiState = sh(script: """
                        aws ec2 describe-images \
                            --image-ids ${env.AMI_ID} \
                            --region ${env.AWS_DEFAULT_REGION} \
                            --query 'Images[0].State' \
                            --output text 2>/dev/null || echo "NOT_FOUND"
                    """, returnStdout: true).trim()
                    
                    if (amiState == 'NOT_FOUND' || amiState == '') {
                        error "❌ AMI ${env.AMI_ID} does not exist in region ${env.AWS_DEFAULT_REGION}"
                    }
                    
                    if (amiState != 'available') {
                        error "❌ AMI ${env.AMI_ID} is in state: ${amiState}. Expected 'available'"
                    }
                    
                    echo "✅ AMI Validation Passed - State: ${amiState}"
                }
            }
        }

        stage('Terraform Init') {
            steps {
                script {
                    // Create terraform directory if it doesn't exist
                    sh """
                        mkdir -p eureka/terraform/${env.TARGET_ENV}
                    """
                }
                dir("eureka/terraform/${env.TARGET_ENV}") {
                    sh """
                        cp ../*.tf . 2>/dev/null || true
                        terraform init
                    """
                }
            }
        }

        stage('Terraform Plan') {
            when { expression { params.ACTION == 'plan' } }
            steps {
                dir("eureka/terraform/${env.TARGET_ENV}") {
                    sh """
                        terraform plan \
                            -var="ami_id=${env.AMI_ID}" \
                            -var="service_name=${env.SERVICE_NAME}" \
                            -var="aws_region=${env.AWS_DEFAULT_REGION}" \
                            -var="eureka_port=${env.EUREKA_PORT}" \
                            -var="environment=${env.TARGET_ENV}" \
                            -var="branch=${env.BUILD_BRANCH}" \
                            -var="subnet_id=${env.SUBNET_ID}" \
                            -var="vpc_id=${env.VPC_ID}" \
                            -var="instance_type=${env.INSTANCE_TYPE}"
                    """
                }
            }
        }

        stage('Terraform Apply') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                dir("eureka/terraform/${env.TARGET_ENV}") {
                    sh """
                        terraform apply -auto-approve \
                            -var="ami_id=${env.AMI_ID}" \
                            -var="service_name=${env.SERVICE_NAME}" \
                            -var="aws_region=${env.AWS_DEFAULT_REGION}" \
                            -var="eureka_port=${env.EUREKA_PORT}" \
                            -var="environment=${env.TARGET_ENV}" \
                            -var="branch=${env.BUILD_BRANCH}" \
                            -var="subnet_id=${env.SUBNET_ID}" \
                            -var="vpc_id=${env.VPC_ID}" \
                            -var="instance_type=${env.INSTANCE_TYPE}"
                    """
                }
            }
        }

        stage('Store Service Discovery Info') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                script {
                    dir("eureka/terraform/${env.TARGET_ENV}") {
                        // Wait a few seconds for instance to be fully ready
                        sh "sleep 10"
                        
                        def private_ip = sh(script: """
                            aws ec2 describe-instances \
                                --filters "Name=tag:Branch,Values=${env.BUILD_BRANCH}" \
                                          "Name=tag:Service,Values=${env.SERVICE_NAME}" \
                                          "Name=instance-state-name,Values=running" \
                                --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                                --region ${env.AWS_DEFAULT_REGION} \
                                --output text
                        """, returnStdout: true).trim()
                        
                        if (private_ip && private_ip != 'None' && private_ip != '') {
                            // Use Groovy for date formatting (no escaping needed)
                            def currentTime = new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'")
                            
                            sh """
                                aws ssm put-parameter \
                                    --name "${env.SSM_PATH}/${env.SERVICE_NAME}/ip" \
                                    --value "${private_ip}" \
                                    --type "String" \
                                    --overwrite || true
                                
                                aws ssm put-parameter \
                                    --name "${env.SSM_PATH}/${env.SERVICE_NAME}/port" \
                                    --value "${env.EUREKA_PORT}" \
                                    --type "String" \
                                    --overwrite || true
                                
                                aws ssm put-parameter \
                                    --name "${env.SSM_PATH}/${env.SERVICE_NAME}/ami" \
                                    --value "${env.AMI_ID}" \
                                    --type "String" \
                                    --overwrite || true
                                
                                aws ssm put-parameter \
                                    --name "${env.SSM_PATH}/${env.SERVICE_NAME}/branch" \
                                    --value "${env.BUILD_BRANCH}" \
                                    --type "String" \
                                    --overwrite || true
                                
                                aws ssm put-parameter \
                                    --name "${env.SSM_PATH}/${env.SERVICE_NAME}/deployed-at" \
                                    --value "${currentTime}" \
                                    --type "String" \
                                    --overwrite || true
                                
                                aws ssm put-parameter \
                                    --name "${env.SSM_PATH}/${env.SERVICE_NAME}/deploy-strategy" \
                                    --value "${env.DEPLOY_STRATEGY}" \
                                    --type "String" \
                                    --overwrite || true
                            """
                            
                            // Store deployment record in S3 for permanent history
                            def deploymentRecord = """{
    "branch": "${env.BUILD_BRANCH}",
    "environment": "${env.TARGET_ENV}",
    "action": "${params.ACTION}",
    "ami_id": "${env.AMI_ID}",
    "private_ip": "${private_ip}",
    "port": "${env.EUREKA_PORT}",
    "deployed_at": "${currentTime}",
    "deploy_strategy": "${env.DEPLOY_STRATEGY}",
    "infra_commit": "${env.INFRA_COMMIT}",
    "timestamp": "${env.TIMESTAMP}"
}"""
                            
                            writeFile file: "deployment-${env.TIMESTAMP}.json", text: deploymentRecord
                            sh """
                                aws s3 cp deployment-${env.TIMESTAMP}.json s3://${env.S3_BUCKET}/eureka/deployments/${env.BUILD_BRANCH}/${env.TIMESTAMP}.json || true
                            """
                            
                            echo "=========================================="
                            echo "✅ Deployment Complete!"
                            echo "=========================================="
                            echo "Environment: ${env.TARGET_ENV}"
                            echo "Branch: ${env.BUILD_BRANCH}"
                            echo "Service: ${env.SERVICE_NAME}"
                            echo "Private IP: ${private_ip}"
                            echo "Port: ${env.EUREKA_PORT}"
                            echo "URL: http://${private_ip}:${env.EUREKA_PORT}/eureka/"
                            echo "AMI ID: ${env.AMI_ID}"
                            echo "Deploy Strategy: ${env.DEPLOY_STRATEGY}"
                            echo "Deployed At: ${currentTime}"
                            echo "S3 Record: s3://${env.S3_BUCKET}/eureka/deployments/${env.BUILD_BRANCH}/${env.TIMESTAMP}.json"
                            echo "=========================================="
                        } else {
                            error "Failed to get instance IP address for ${env.TARGET_ENV}. Instance may not be running yet or tags are incorrect."
                        }
                    }
                }
            }
        }

        stage('Terraform Destroy') {
            when { expression { params.ACTION == 'destroy' } }
            steps {
                script {
                    echo "=========================================="
                    echo "Destroying Eureka service in ${env.TARGET_ENV}"
                    echo "=========================================="
                    
                    // Clean up SSM parameters
                    sh """
                        aws ssm delete-parameter --name "${env.SSM_PATH}/${env.SERVICE_NAME}/ip" 2>/dev/null || true
                        aws ssm delete-parameter --name "${env.SSM_PATH}/${env.SERVICE_NAME}/port" 2>/dev/null || true
                        aws ssm delete-parameter --name "${env.SSM_PATH}/${env.SERVICE_NAME}/ami" 2>/dev/null || true
                        aws ssm delete-parameter --name "${env.SSM_PATH}/${env.SERVICE_NAME}/branch" 2>/dev/null || true
                        aws ssm delete-parameter --name "${env.SSM_PATH}/${env.SERVICE_NAME}/deployed-at" 2>/dev/null || true
                        aws ssm delete-parameter --name "${env.SSM_PATH}/${env.SERVICE_NAME}/deploy-strategy" 2>/dev/null || true
                    """
                }
                dir("eureka/terraform/${env.TARGET_ENV}") {
                    sh "terraform destroy -auto-approve"
                }
                
                script {
                    echo "=========================================="
                    echo "✅ Destroy Complete!"
                    echo "=========================================="
                    echo "Environment: ${env.TARGET_ENV}"
                    echo "Service: ${env.SERVICE_NAME}"
                    echo "=========================================="
                }
            }
        }
    }

    post {
        success {
            echo "=========================================="
            echo "✅ Eureka ${params.ACTION} for ${params.BRANCH} completed successfully!"
            echo "=========================================="
            if (params.ACTION == 'apply') {
                echo "Environment: ${env.TARGET_ENV}"
                echo "Service: ${env.SERVICE_NAME}"
                echo "AMI ID: ${env.AMI_ID}"
                echo "=========================================="
            }
        }
        failure {
            echo "=========================================="
            echo "❌ Eureka ${params.ACTION} for ${params.BRANCH} failed!"
            echo "=========================================="
            echo "Please check the logs above for detailed error messages."
            echo "=========================================="
        }
        always {
            echo "Pipeline execution completed at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
        }
    }
}