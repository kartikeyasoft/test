@Library('jenkins-shared-lib-deno@main') _

pipeline {
    agent any

    parameters {
        choice(name: 'ACTION', choices: ['apply', 'destroy', 'plan'], description: 'Terraform action')
        string(name: 'AMI_ID', defaultValue: '', description: 'Eureka AMI ID (leave empty to get latest from SSM based on branch)')
        choice(name: 'BRANCH', choices: ['dev', 'qa', 'master'], description: 'Git branch (maps to environment: dev→dev, qa→qa, master→prod)')
    }

    environment {
        AWS_ACCESS_KEY_ID = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
    }

    stages {
        stage('Load Configuration') {
            steps {
                script {
                    // Get timestamp
                    env.TIMESTAMP = sh(script: 'date +%Y%m%d-%H%M%S', returnStdout: true).trim()
                    
                    // Get configurations from shared library
                    def config = envConfig()
                    
                    // Branch to environment mapping
                    if (params.BRANCH == 'main' || params.BRANCH == 'master') {
                        env.TARGET_ENV = 'prod'
                        env.AUTO_DEPLOY = 'false'
                        env.REQUIRE_APPROVAL = 'true'
                        env.INSTANCE_TYPE = 't3.medium'
                        env.KEY_NAME = 'ksansible-prod'
                    } else if (params.BRANCH == 'qa') {
                        env.TARGET_ENV = 'qa'
                        env.AUTO_DEPLOY = 'true'
                        env.REQUIRE_APPROVAL = 'false'
                        env.INSTANCE_TYPE = 't3.micro'
                        env.KEY_NAME = 'ksansible'
                    } else {
                        env.TARGET_ENV = 'dev'
                        env.AUTO_DEPLOY = 'true'
                        env.REQUIRE_APPROVAL = 'false'
                        env.INSTANCE_TYPE = 't3.micro'
                        env.KEY_NAME = 'ksansible'
                    }
                    
                    // AWS Configuration
                    env.AWS_DEFAULT_REGION = config.aws.region
                    env.SERVICE_NAME = 'eureka'
                    env.EUREKA_PORT = config.eureka.defaultPort
                    
                    // Environment-specific VPC configuration
                    def envConfigs = [
                        dev: [
                            vpc_cidr: '192.168.0.0/16',
                            subnet_id: 'subnet-076bd99dde1330498',
                            vpc_id: 'vpc-0310386fea2f2ce82',
                            ssm_path: '/exam/dev'
                        ],
                        qa: [
                            vpc_cidr: '172.31.0.0/16',
                            subnet_id: 'subnet-0aa31e769c8f4d73e',
                            vpc_id: 'vpc-0cb7deb47a6bfa727',
                            ssm_path: '/exam/qa'
                        ],
                        prod: [
                            vpc_cidr: '10.2.0.0/16',
                            subnet_id: 'subnet-09c74646d4a4c2794',
                            vpc_id: 'vpc-06cf33d3bcdcf4be9',
                            ssm_path: '/exam/prod'
                        ]
                    ]
                    
                    def envData = envConfigs[env.TARGET_ENV]
                    env.SUBNET_ID = envData.subnet_id
                    env.VPC_ID = envData.vpc_id
                    env.SSM_PATH = envData.ssm_path
                    
                    // AMI ID
                    env.AMI_ID = params.AMI_ID
                    env.BUILD_BRANCH = params.BRANCH
                    
                    echo "=========================================="
                    echo "Eureka CD Pipeline - Branch: ${params.BRANCH}"
                    echo "=========================================="
                    echo "Target Environment: ${env.TARGET_ENV}"
                    echo "Action: ${params.ACTION}"
                    echo "Instance Type: ${env.INSTANCE_TYPE}"
                    echo "Subnet ID: ${env.SUBNET_ID}"
                    echo "VPC ID: ${env.VPC_ID}"
                    echo "AMI ID: ${env.AMI_ID ?: 'Will fetch from SSM'}"
                    echo "Key Name: ${env.KEY_NAME}"
                    echo "=========================================="
                }
            }
        }

        stage('Checkout Infrastructure Code') {
            steps {
                script {
                    def infraRepo = 'https://github.com/kartikeyasoft/test.git'
                    def infraBranch = params.BRANCH
                    
                    echo "Checking out infrastructure code from branch: ${infraBranch}"
                    git url: infraRepo, branch: infraBranch
                    
                    env.INFRA_COMMIT = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    echo "✅ Checkout complete - Commit: ${env.INFRA_COMMIT}"
                }
            }
        }

        stage('Approval Required') {
            when { 
                expression { 
                    params.ACTION == 'apply' && 
                    env.REQUIRE_APPROVAL == 'true' 
                } 
            }
            steps {
                input message: "Approve deployment to ${env.TARGET_ENV} (${params.BRANCH} branch)?",
                    ok: "Deploy",
                    parameters: [
                        string(name: 'APPROVER', defaultValue: "${env.BUILD_USER_ID ?: 'Unknown'}", description: 'Approver name'),
                        text(name: 'DEPLOY_NOTES', defaultValue: "Deploying ${env.SERVICE_NAME} from ${params.BRANCH} branch", description: 'Deployment notes')
                    ]
            }
        }

        stage('Get AMI ID from SSM') {
            when { 
                expression { 
                    params.ACTION in ['apply', 'plan'] && 
                    (!env.AMI_ID || env.AMI_ID == '') 
                } 
            }
            steps {
                script {
                    echo "Fetching latest AMI for branch: ${params.BRANCH}"
                    
                    def amiId = sh(script: """
                        aws ssm get-parameter \
                            --name "/eureka/${params.BRANCH}/latest-ami" \
                            --region ${env.AWS_DEFAULT_REGION} \
                            --query "Parameter.Value" \
                            --output text 2>/dev/null || echo ""
                    """, returnStdout: true).trim()
                    
                    if (!amiId || amiId == '') {
                        error """
                        ❌ No Eureka AMI found for branch: ${params.BRANCH}
                        
                        Please run eureka-ci pipeline for ${params.BRANCH} branch first.
                        Expected SSM path: /eureka/${params.BRANCH}/latest-ami
                        """
                    }
                    
                    env.AMI_ID = amiId
                    echo "✅ Using AMI from SSM: ${env.AMI_ID}"
                }
            }
        }

        stage('Validate AMI') {
            when { expression { params.ACTION in ['apply', 'plan'] } }
            steps {
                script {
                    if (!env.AMI_ID || env.AMI_ID == '') {
                        error "AMI_ID is required for ${params.ACTION} action"
                    }
                    
                    def amiState = sh(script: """
                        aws ec2 describe-images \
                            --image-ids ${env.AMI_ID} \
                            --region ${env.AWS_DEFAULT_REGION} \
                            --query 'Images[0].State' \
                            --output text 2>/dev/null || echo "NOT_FOUND"
                    """, returnStdout: true).trim()
                    
                    if (amiState == 'NOT_FOUND' || amiState == '') {
                        error "❌ AMI ${env.AMI_ID} does not exist"
                    }
                    
                    echo "✅ AMI Validation Passed - State: ${amiState}"
                }
            }
        }

        stage('Terraform Init') {
            steps {
                dir("eureka/terraform/${env.TARGET_ENV}") {
                    sh """
                        cp ../*.tf . 2>/dev/null || true
                        terraform init
                    """
                }
            }
        }

        stage('Terraform Plan') {
            when { expression { params.ACTION == 'plan' } }
            steps {
                dir("eureka/terraform/${env.TARGET_ENV}") {
                    sh """
                        terraform plan \
                            -var="ami_id=${env.AMI_ID}" \
                            -var="service_name=${env.SERVICE_NAME}" \
                            -var="branch=${params.BRANCH}" \
                            -var="aws_region=${env.AWS_DEFAULT_REGION}" \
                            -var="eureka_port=${env.EUREKA_PORT}" \
                            -var="environment=${env.TARGET_ENV}" \
                            -var="subnet_id=${env.SUBNET_ID}" \
                            -var="vpc_id=${env.VPC_ID}" \
                            -var="instance_type=${env.INSTANCE_TYPE}" \
                            -var="key_name=${env.KEY_NAME}"
                    """
                }
            }
        }

        stage('Terraform Apply') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                dir("eureka/terraform/${env.TARGET_ENV}") {
                    sh """
                        terraform apply -auto-approve \
                            -var="ami_id=${env.AMI_ID}" \
                            -var="service_name=${env.SERVICE_NAME}" \
                            -var="branch=${params.BRANCH}" \
                            -var="aws_region=${env.AWS_DEFAULT_REGION}" \
                            -var="eureka_port=${env.EUREKA_PORT}" \
                            -var="environment=${env.TARGET_ENV}" \
                            -var="subnet_id=${env.SUBNET_ID}" \
                            -var="vpc_id=${env.VPC_ID}" \
                            -var="instance_type=${env.INSTANCE_TYPE}" \
                            -var="key_name=${env.KEY_NAME}"
                    """
                }
            }
        }

        stage('Store Service Discovery Info') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                script {
                    dir("eureka/terraform/${env.TARGET_ENV}") {
                        sh "sleep 10"
                        
                        def private_ip = sh(script: """
                            aws ec2 describe-instances \
                                --filters "Name=tag:Branch,Values=${params.BRANCH}" \
                                          "Name=tag:Service,Values=${env.SERVICE_NAME}" \
                                          "Name=instance-state-name,Values=running" \
                                --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                                --region ${env.AWS_DEFAULT_REGION} \
                                --output text
                        """, returnStdout: true).trim()
                        
                        if (private_ip && private_ip != 'None') {
                            def currentTime = new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'")
                            
                            sh """
                                aws ssm put-parameter \
                                    --name "${env.SSM_PATH}/${env.SERVICE_NAME}/ip" \
                                    --value "${private_ip}" \
                                    --type "String" \
                                    --overwrite || true
                                
                                aws ssm put-parameter \
                                    --name "${env.SSM_PATH}/${env.SERVICE_NAME}/port" \
                                    --value "${env.EUREKA_PORT}" \
                                    --type "String" \
                                    --overwrite || true
                                
                                aws ssm put-parameter \
                                    --name "${env.SSM_PATH}/${env.SERVICE_NAME}/ami" \
                                    --value "${env.AMI_ID}" \
                                    --type "String" \
                                    --overwrite || true
                                
                                aws ssm put-parameter \
                                    --name "${env.SSM_PATH}/${env.SERVICE_NAME}/branch" \
                                    --value "${params.BRANCH}" \
                                    --type "String" \
                                    --overwrite || true
                                
                                aws ssm put-parameter \
                                    --name "${env.SSM_PATH}/${env.SERVICE_NAME}/deployed-at" \
                                    --value "${currentTime}" \
                                    --type "String" \
                                    --overwrite || true
                            """
                            
                            echo "=========================================="
                            echo "✅ Deployment Complete!"
                            echo "=========================================="
                            echo "Environment: ${env.TARGET_ENV}"
                            echo "Branch: ${params.BRANCH}"
                            echo "Service: ${env.SERVICE_NAME}"
                            echo "Private IP: ${private_ip}"
                            echo "Port: ${env.EUREKA_PORT}"
                            echo "URL: http://${private_ip}:${env.EUREKA_PORT}/eureka/"
                            echo "AMI ID: ${env.AMI_ID}"
                            echo "=========================================="
                        } else {
                            echo "⚠️ Could not find running instance, but terraform apply completed successfully"
                        }
                    }
                }
            }
        }

        stage('Terraform Destroy') {
            when { expression { params.ACTION == 'destroy' } }
            steps {
                script {
                    sh """
                        aws ssm delete-parameter --name "${env.SSM_PATH}/${env.SERVICE_NAME}/ip" 2>/dev/null || true
                        aws ssm delete-parameter --name "${env.SSM_PATH}/${env.SERVICE_NAME}/port" 2>/dev/null || true
                        aws ssm delete-parameter --name "${env.SSM_PATH}/${env.SERVICE_NAME}/ami" 2>/dev/null || true
                        aws ssm delete-parameter --name "${env.SSM_PATH}/${env.SERVICE_NAME}/branch" 2>/dev/null || true
                        aws ssm delete-parameter --name "${env.SSM_PATH}/${env.SERVICE_NAME}/deployed-at" 2>/dev/null || true
                    """
                }
                dir("eureka/terraform/${env.TARGET_ENV}") {
                    sh "terraform destroy -auto-approve"
                }
                
                echo "=========================================="
                echo "✅ Destroy Complete for ${env.TARGET_ENV}"
                echo "=========================================="
            }
        }
    }

    post {
        success {
            script {
                echo "=========================================="
                echo "✅ CD Success for ${params.BRANCH}!"
                echo "=========================================="
                if (params.ACTION == 'apply') {
                    echo "Environment: ${env.TARGET_ENV}"
                    echo "AMI ID: ${env.AMI_ID}"
                }
                echo "=========================================="
            }
        }
        failure {
            script {
                echo "=========================================="
                echo "❌ CD Failed for branch ${params.BRANCH}"
                echo "=========================================="
            }
        }
    }
}