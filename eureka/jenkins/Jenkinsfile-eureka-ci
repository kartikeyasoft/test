@Library('jenkins-shared-lib-deno@main') _

pipeline {
    agent any

    parameters {
        choice(name: 'ACTION', choices: ['build', 'build-and-deploy'], description: 'Action to perform')
        string(name: 'TARGET_ENV', defaultValue: 'dev', description: 'Environment for CD (dev/qa/prod)')
    }

    tools {
        maven 'Maven-3.8'
        jdk 'JDK-17'
    }

    environment {
        PATH = "/usr/bin:${env.PATH}"
        
        NEXUS_CREDS = credentials('nexus-creds')
        AWS_ACCESS_KEY_ID = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        
        SERVICE_NAME = 'eureka'
    }

    stages {
        stage('Load Configuration') {
            steps {
                script {
                    def config = envConfig()
                    
                    env.NEXUS_URL = config.nexus.url
                    env.AWS_DEFAULT_REGION = config.aws.region
                    env.EUREKA_PORT = config.eureka.defaultPort
                    env.BASE_AMI_ID = config.baseAmi.ubuntu2204
                    
                    echo "=========================================="
                    echo "Eureka CI Pipeline (Environment Agnostic)"
                    echo "=========================================="
                    echo "Action: ${params.ACTION}"
                    echo "Will deploy to: ${params.TARGET_ENV} (if build-and-deploy)"
                    echo "=========================================="
                }
            }
        }

        stage('Checkout') {
            steps {
                git url: 'https://github.com/kartikeyasoft/test.git', branch: 'master'
            }
        }

        stage('Set Version') {
            steps {
                dir('eureka') {
                    script {
                        env.SERVICE_VERSION = sh(script: 'mvn help:evaluate -Dexpression=project.version -q -DforceStdout', returnStdout: true).trim()
                        echo "Building version: ${env.SERVICE_VERSION}"
                    }
                }
            }
        }

        stage('Maven Compile') {
            when { expression { params.ACTION in ['build', 'build-and-deploy'] } }
            steps {
                dir('eureka') {
                    sh 'mvn clean compile -Dmaven.test.skip=true'
                }
            }
        }

        stage('SonarQube Analysis') {
            when { expression { params.ACTION in ['build', 'build-and-deploy'] } }
            steps {
                dir('eureka') {
                    withSonarQubeEnv('sonar') {
                        sh """
                            mvn sonar:sonar \
                                -Dsonar.projectKey=com.ksapp:eureka \
                                -Dsonar.projectName="Eureka_Service_Registry_v${env.SERVICE_VERSION}" \
                                -Dsonar.projectVersion=${env.SERVICE_VERSION} \
                                -Dsonar.sources=src/main/java \
                                -Dsonar.java.binaries=target/classes
                        """
                    }
                }
            }
        }

        stage('Maven Package') {
            when { expression { params.ACTION in ['build', 'build-and-deploy'] } }
            steps {
                dir('eureka') {
                    sh 'mvn package -Dmaven.test.skip=true'
                }
            }
        }

        stage('Deploy to Nexus') {
            when { expression { params.ACTION in ['build', 'build-and-deploy'] } }
            steps {
                dir('eureka') {
                    script {
                        def jarFile = "target/eureka-${env.SERVICE_VERSION}.jar"
                        def nexusPath = "${env.NEXUS_URL}/com/ksapp/eureka/${env.SERVICE_VERSION}/eureka-${env.SERVICE_VERSION}.jar"
                        
                        withCredentials([usernamePassword(credentialsId: 'nexus-creds', 
                                                        usernameVariable: 'NEXUS_USER', 
                                                        passwordVariable: 'NEXUS_PASS')]) {
                            sh """
                                curl -f -u ${NEXUS_USER}:${NEXUS_PASS} --upload-file ${jarFile} ${nexusPath}
                            """
                        }
                    }
                }
            }
        }

        stage('Bake Golden Image') {
            when { expression { params.ACTION in ['build', 'build-and-deploy'] } }
            steps {
                script {
                    withEnv([
                        "SERVICE_VERSION=${env.SERVICE_VERSION}",
                        "SERVICE_NAME=${env.SERVICE_NAME}",
                        "NEXUS_URL=${env.NEXUS_URL}",
                        "EUREKA_PORT=${env.EUREKA_PORT}",
                        "BASE_AMI_ID=${env.BASE_AMI_ID}"
                    ]) {
                        dir('eureka/packer') {
                            sh '''
                                packer init eureka.pkr.hcl
                                packer build \
                                    -var "service_version=${SERVICE_VERSION}" \
                                    -var "service_name=${SERVICE_NAME}" \
                                    -var "nexus_url=${NEXUS_URL}" \
                                    -var "eureka_port=${EUREKA_PORT}" \
                                    -var "source_ami=${BASE_AMI_ID}" \
                                    eureka.pkr.hcl 2>&1 | tee build-output.txt
                                
                                AMI_ID=$(grep -oE 'ami-[a-f0-9]{17}' build-output.txt | tail -1)
                                echo "GOLDEN_AMI_ID=$AMI_ID" > golden-ami.properties
                                echo "Successfully created AMI: $AMI_ID"
                            '''
                            
                            script {
                                def amiProps = readFile('golden-ami.properties')
                                env.AMI_ID = amiProps.split('=')[1].trim()
                                echo "✅ Captured AMI ID: ${env.AMI_ID}"
                            }
                            stash name: 'eureka-ami', includes: 'golden-ami.properties'
                        }
                    }
                }
            }
        }

        stage('Trigger CD Pipeline') {
            when { expression { params.ACTION == 'build-and-deploy' && env.AMI_ID != '' } }
            steps {
                script {
                    echo "=========================================="
                    echo "Triggering CD Pipeline for ${params.TARGET_ENV}"
                    echo "=========================================="
                    echo "Version: ${env.SERVICE_VERSION}"
                    echo "AMI ID: ${env.AMI_ID}"
                    echo "Target Environment: ${params.TARGET_ENV}"
                    echo "=========================================="
                    
                    if (env.AMI_ID && env.AMI_ID != '' && env.AMI_ID =~ /^ami-[a-f0-9]{17}$/) {
                        build job: 'eureka-cd',
                            parameters: [
                                string(name: 'AMI_ID', value: env.AMI_ID),
                                string(name: 'ENVIRONMENT', value: params.TARGET_ENV),
                                choice(name: 'ACTION', value: 'apply')
                            ],
                            wait: false
                        
                        echo "✅ CD pipeline triggered for ${params.TARGET_ENV}!"
                    } else {
                        error "❌ Invalid AMI ID: ${env.AMI_ID}"
                    }
                }
            }
        }
    }

    post {
        success {
            echo "🎉 Eureka CI completed! AMI: ${env.AMI_ID}"
        }
        failure {
            echo "❌ Eureka CI failed!"
        }
    }
}