@Library('jenkins-shared-lib-deno@main') _

pipeline {
    agent any

    parameters {
        choice(name: 'ACTION', choices: ['build', 'build-and-deploy'], description: 'Action to perform')
        choice(name: 'BRANCH', choices: ['dev', 'qa', 'master', 'main'], description: 'Git branch')
    }

    tools {
        maven 'Maven-3.8'
        jdk 'JDK-17'
    }

    environment {
        PATH = "/usr/bin:${env.PATH}"
        
       
        AWS_CONFIG_FILE = '/var/lib/jenkins/.aws/config'
    }

    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/kartikeyasoft/test.git', 
                    branch: params.BRANCH
                
                script {
                    env.BUILD_BRANCH = params.BRANCH
                    env.GIT_COMMIT = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.TIMESTAMP = sh(script: 'date +%Y%m%d-%H%M%S', returnStdout: true).trim()
                    
                    echo "Checked out branch: ${env.BUILD_BRANCH}"
                    echo "Commit: ${env.GIT_COMMIT}"
                    echo "Timestamp: ${env.TIMESTAMP}"
                }
            }
        }

        stage('Gitleaks Security Scan') {
            steps {
                script {
                    echo "=========================================="
                    echo "🔍 Running Gitleaks Secret Detection"
                    echo "=========================================="
                    
                    // Only fail on main/master branches
                    // For dev/qa, just warn and continue
                    def shouldFailOnFindings = (env.BUILD_BRANCH in ['main', 'master'])
                    
                    echo "Branch: ${env.BUILD_BRANCH}"
                    echo "Will fail build: ${shouldFailOnFindings}"
                    
                    // Call shared library step
                    gitleaksScan(
                        failOnFindings: shouldFailOnFindings
                    )
                    
                    echo "=========================================="
                    echo "✅ Gitleaks Scan Completed"
                    echo "=========================================="
                }
            }
        }

        stage('Setup Branch Config') {
            steps {
                script {
                    if (env.BUILD_BRANCH == 'main' || env.BUILD_BRANCH == 'master') {
                        env.TARGET_ENV = 'prod'
                        env.AUTO_DEPLOY = 'false'
                    } else if (env.BUILD_BRANCH == 'qa') {
                        env.TARGET_ENV = 'qa'
                        env.AUTO_DEPLOY = 'true'
                    } else {
                        env.TARGET_ENV = 'dev'
                        env.AUTO_DEPLOY = 'true'
                    }
                    
                    echo "=========================================="
                    echo "Building Branch: ${env.BUILD_BRANCH}"
                    echo "Target Environment: ${env.TARGET_ENV}"
                    echo "Auto Deploy: ${env.AUTO_DEPLOY}"
                    echo "=========================================="
                }
            }
        }

        stage('Load Configuration') {
            steps {
                script {
                    try {
                        def config = envConfig()
                        
                        // Debug: Print config structure
                        echo "Config type: ${config.getClass()}"
                        echo "Config keys: ${config.keySet()}"
                        
                        // Load values from shared library
                        env.NEXUS_URL = config.nexus.url
                        env.AWS_DEFAULT_REGION = config.aws.region
                        env.EUREKA_PORT = config.eureka.defaultPort
                        env.BASE_AMI_ID = config.baseAmi.ubuntu2204
                        env.SERVICE_NAME = config.servicename.obj1
                        env.S3_BUCKET = config.s3.bucket
                        
                        echo "=========================================="
                        echo "Loaded Configuration"
                        echo "=========================================="
                        echo "Nexus URL: ${env.NEXUS_URL}"
                        echo "AWS Region: ${env.AWS_DEFAULT_REGION}"
                        echo "Eureka Port: ${env.EUREKA_PORT}"
                        echo "Base AMI: ${env.BASE_AMI_ID}"
                        echo "Service Name: ${env.SERVICE_NAME}"
                        echo "S3 Bucket Name: ${env.S3_BUCKET}"
                        echo "=========================================="
                    } catch (Exception e) {
                        echo "ERROR loading configuration: ${e.getMessage()}"
                        echo "Stack trace:"
                        e.printStackTrace()
                        throw e
                    }
                }
            }
        }

        stage('Set Version') {
            steps {
                dir('eureka') {
                    script {
                        env.SERVICE_VERSION = sh(script: 'mvn help:evaluate -Dexpression=project.version -q -DforceStdout', returnStdout: true).trim()
                        echo "Building version: ${env.SERVICE_VERSION}"
                    }
                }
            }
        }

        stage('Maven Build') {
            when { expression { params.ACTION in ['build', 'build-and-deploy'] } }
            steps {
                dir('eureka') {
                    sh 'mvn clean package -Dmaven.test.skip=true'
                }
            }
        }

        stage('Trivy Security Scan') {
            when { 
                expression { params.ACTION in ['build', 'build-and-deploy'] } 
            }
            
            steps {
                dir('eureka') {
                    script {
                        def branchName = env.BUILD_BRANCH ?: env.BRANCH_NAME ?: 'dev'
                        def shouldFail = (branchName in ['main', 'master', 'production'])
                        
                        echo "📋 Pipeline Diagnostics:"
                        echo "   - Context Module: eureka"
                        echo "   - Current Branch: ${branchName}"
                        echo "   - Enforce Strict Failures: ${shouldFail}"
                        
                        trivyScan(shouldFail)
                    }
                }
            }
        }

        stage('Checkov Security Scan') {
            // Run when building or deploying
            when { 
                expression { params.ACTION in ['build', 'build-and-deploy'] } 
            }
            
            steps {
                script {
                    // Identify branch for guardrail tracking
                    def branchName = env.BUILD_BRANCH ?: env.BRANCH_NAME ?: 'dev'
                    def shouldFail = (branchName in ['main', 'master', 'production'])
                    
                    echo "📋 Checkov Pipeline Diagnostics:"
                    echo "   - Scan Target: Root Repository Context (Terraform, Packer, Docker)"
                    echo "   - Current Branch: ${branchName}"
                    echo "   - Enforce Strict Failures: ${shouldFail}"
                    
                    // Invoke our custom checkov shared library function
                    checkovScan(shouldFail)
                }
            }
        }

        stage('SonarQube Analysis') {
            when { expression { params.ACTION in ['build', 'build-and-deploy'] } }
            steps {
                dir('eureka') {
                    // All complex configurations, token injections, and tool evaluations are managed here:
                    sonarScan(
                        projectKey: 'com.ksapp:eureka',
                        projectName: "Eureka_${env.BUILD_BRANCH}"
                    )
                }
            }
        }
              

        stage('Deploy to Nexus') {
            when { expression { params.ACTION in ['build', 'build-and-deploy'] } }
            steps {
                dir('eureka') {
                    script {
                        def jarFile = "target/eureka-${env.SERVICE_VERSION}.jar"
                        def nexusPath = "${env.NEXUS_URL}/com/ksapp/eureka/${env.SERVICE_VERSION}/eureka-${env.SERVICE_VERSION}.jar"
                        
                        if (!fileExists(jarFile)) {
                            error "❌ JAR file not found: ${jarFile}"
                        }
                        
                        // Call the Shared Library step and pass the specific path
                        def credentials = fetchVaultSecret('secret/data/nexus')
                        def nexusUser = credentials.username
                        def nexusPass = credentials.password
                        
                        echo "🚀 Uploading artifact to Nexus Repository..."
                        
                        // Use withCredentials or wrap this to prevent password exposure in logs
                        sh """
                            curl -f -u "${nexusUser}:${nexusPass}" \
                                --upload-file ${jarFile} \
                                ${nexusPath}
                        """
                        
                        echo "✅ Successfully deployed to Nexus"
                    }
                }
            }
        }

        stage('Bake Golden AMI') {
            when { expression { params.ACTION in ['build', 'build-and-deploy'] } }
            steps {
                script {
                    dir('eureka/packer') {
                        sh '''
                            echo "=== Building AMI with branch name ==="
                            echo "Branch: ${BUILD_BRANCH}"
                            echo "Version: ${SERVICE_VERSION}"
                            echo "Commit: ${GIT_COMMIT}"
                            echo "Build Number: ${BUILD_NUMBER}"
                        '''
                        
                        sh '''
                            packer ini eureka.pkr.hcl
                            
                            packer build \
                                -var "service_version=${SERVICE_VERSION}" \
                                -var "service_name=${SERVICE_NAME}" \
                                -var "nexus_url=${NEXUS_URL}" \
                                -var "eureka_port=${EUREKA_PORT}" \
                                -var "source_ami=${BASE_AMI_ID}" \
                                -var "git_branch=${BUILD_BRANCH}" \
                                -var "git_commit=${GIT_COMMIT}" \
                                -var "build_number=${BUILD_NUMBER}" \
                                eureka.pkr.hcl 2>&1 | tee build-output.txt
                            
                            AMI_ID=$(grep -oE 'ami-[a-f0-9]{17}' build-output.txt | tail -1)
                            
                            if [ -z "$AMI_ID" ]; then
                                echo "ERROR: Failed to extract AMI ID from build output"
                                tail -20 build-output.txt
                                exit 1
                            fi
                            
                            echo "AMI_ID=$AMI_ID" > ami.properties
                            echo "Successfully created AMI: $AMI_ID"
                        '''
                        
                        script {
                            def amiProps = readFile('ami.properties')
                            env.AMI_ID = amiProps.split('=')[1].trim()
                            echo "✅ AMI Created: ${env.AMI_ID}"
                            
                            def amiName = "myapp-${env.SERVICE_NAME}-${env.SERVICE_VERSION}-${env.BUILD_BRANCH}-*"
                            echo "📝 AMI Name Pattern: ${amiName}"
                        }
                    }
                }
            }
        }


        stage('Store AMI Info in S3 + SSM') {
            when { expression { env.AMI_ID != null && env.AMI_ID != '' } }
            steps {
                script {
                    // Trim S3 bucket name (remove any spaces)
                    env.S3_BUCKET = env.S3_BUCKET.trim()
                    
                    // Create metadata JSON manually using writeFile
                    def amiMetadata = """{
            "ami_id": "${env.AMI_ID}",
            "branch": "${env.BUILD_BRANCH}",
            "version": "${env.SERVICE_VERSION}",
            "build_number": "${env.BUILD_NUMBER}",
            "commit": "${env.GIT_COMMIT}",
            "timestamp": "${env.TIMESTAMP}",
            "created_at": "${new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'")}",
            "service_name": "${env.SERVICE_NAME}",
            "environment": "${env.TARGET_ENV}",
            "source_ami": "${env.BASE_AMI_ID}",
            "eureka_port": "${env.EUREKA_PORT}"
        }"""
                    
                    writeFile file: 'ami-metadata.json', text: amiMetadata
                    
                    // Create S3 bucket if it doesn't exist (with trimmed name)
                    sh """
                        # Trim bucket name and create if needed
                        S3_BUCKET_TRIMMED="${env.S3_BUCKET}"
                        aws s3 mb s3://\${S3_BUCKET_TRIMMED} --region ${env.AWS_DEFAULT_REGION} 2>/dev/null || true
                        aws s3api put-bucket-versioning --bucket \${S3_BUCKET_TRIMMED} --versioning-configuration Status=Enabled 2>/dev/null || true
                    """
                    
                    // Upload to S3 (complete history - source of truth)
                    // IMPORTANT: No space between bucket name and path!
                    sh """
                        echo "Uploading AMI metadata to S3..."
                        
                        # Store with timestamp (complete history)
                        aws s3 cp ami-metadata.json s3://${env.S3_BUCKET}/eureka/amis/${env.BUILD_BRANCH}/${env.TIMESTAMP}.json
                        
                        # Store as latest (overwrites)
                        aws s3 cp ami-metadata.json s3://${env.S3_BUCKET}/eureka/latest/${env.BUILD_BRANCH}.json
                        
                        echo "✅ S3 upload complete"
                    """
                    
                    // Update SSM (fast cache - latest pointers only)
                    sh """
                        echo "Updating SSM parameters..."
                        
                        aws ssm put-parameter \
                            --name "/eureka/${env.BUILD_BRANCH}/latest-ami" \
                            --value "${env.AMI_ID}" \
                            --type "String" \
                            --overwrite \
                            --description "Latest AMI for ${env.BUILD_BRANCH} branch" || true
                        
                        aws ssm put-parameter \
                            --name "/eureka/${env.BUILD_BRANCH}/latest-version" \
                            --value "${env.SERVICE_VERSION}" \
                            --type "String" \
                            --overwrite || true
                        
                        aws ssm put-parameter \
                            --name "/eureka/${env.BUILD_BRANCH}/metadata-location" \
                            --value "s3://${env.S3_BUCKET}/eureka/latest/${env.BUILD_BRANCH}.json" \
                            --type "String" \
                            --overwrite || true
                        
                        aws ssm put-parameter \
                            --name "/eureka/latest-ami" \
                            --value "${env.AMI_ID}" \
                            --type "String" \
                            --overwrite \
                            --description "Most recent AMI across all branches" || true
                        
                        echo "✅ SSM parameters updated"
                    """
                    
                    echo "=========================================="
                    echo "✅ AMI Information Stored Successfully"
                    echo "=========================================="
                    echo "AMI ID: ${env.AMI_ID}"
                    echo "S3 Path: s3://${env.S3_BUCKET}/eureka/amis/${env.BUILD_BRANCH}/${env.TIMESTAMP}.json"
                    echo "SSM: /eureka/${env.BUILD_BRANCH}/latest-ami = ${env.AMI_ID}"
                    echo "=========================================="
                }
            }
        }   

        stage('Trigger CD') {
            when { 
                expression { 
                    params.ACTION == 'build-and-deploy' && 
                    env.AUTO_DEPLOY == 'true' &&
                    env.AMI_ID != null &&
                    env.AMI_ID != ''
                } 
            }
            steps {
                script {
                    echo "Auto-deploying ${env.BUILD_BRANCH} to ${env.TARGET_ENV}"
                    
                    // FIXED: Changed 'choice' to 'string' for ACTION parameter
                    build job: 'eureka-cd',
                        parameters: [
                            string(name: 'ENVIRONMENT', value: env.TARGET_ENV),
                            string(name: 'AMI_ID', value: env.AMI_ID),
                            string(name: 'ACTION', value: 'apply')  // Changed from 'choice' to 'string'
                        ],
                        wait: false
                }
            }
        }
        
        stage('Manual Deploy Required') {
            when { 
                expression { 
                    params.ACTION == 'build-and-deploy' && 
                    env.AUTO_DEPLOY == 'false' &&
                    env.AMI_ID != null &&
                    env.AMI_ID != ''
                } 
            }
            steps {
                script {
                    echo "=========================================="
                    echo "✅ AMI Built Successfully"
                    echo "=========================================="
                    echo "Branch: ${env.BUILD_BRANCH}"
                    echo "AMI ID: ${env.AMI_ID}"
                    echo "S3 Path: s3://${env.S3_BUCKET}/eureka/amis/${env.BUILD_BRANCH}/${env.TIMESTAMP}.json"
                    echo ""
                    echo "To deploy to ${env.TARGET_ENV}:"
                    echo "  Job: eureka-cd"
                    echo "  Parameters:"
                    echo "    - ENVIRONMENT: ${env.TARGET_ENV}"
                    echo "    - AMI_ID: ${env.AMI_ID}"
                    echo "=========================================="
                }
            }
        }
    }

    post {
        success {
            echo "=========================================="
            echo "✅ CI Success!"
            echo "=========================================="
            echo "Branch: ${env.BUILD_BRANCH}"
            echo "AMI ID: ${env.AMI_ID}"
            echo "S3: s3://${env.S3_BUCKET}/eureka/amis/${env.BUILD_BRANCH}/"
            echo "SSM: /eureka/${env.BUILD_BRANCH}/latest-ami"
            echo "=========================================="
        }
        failure {
            echo "=========================================="
            echo "❌ CI Failed for branch ${env.BUILD_BRANCH}"
            echo "=========================================="
            script {
                dir('eureka/packer') {
                    sh '''
                        if [ -f build-output.txt ]; then
                            echo "=== Last 50 lines of Packer build output ==="
                            tail -50 build-output.txt
                        fi
                    '''
                }
            }
        }
    }
}
